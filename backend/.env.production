# Production Environment Variables for Backend (MilesWeb)
# Fill in your actual production values before deploying

# Database Configuration (use MilesWeb's PostgreSQL details from cPanel)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_DATABASE=your_db_name

# For connect-pg-simple session store
DATABASE_URL=postgresql://your_db_username:your_db_password@localhost:5432/your_db_name

# Application
PORT=3001
NODE_ENV=production

# CORS - Your frontend domain (comma-separated if multiple)
CORS_ORIGIN=https://YOUR_DOMAIN.com,https://www.YOUR_DOMAIN.com

# Session Secret - CHANGE THIS to a strong random string!
SESSION_SECRET=generate-a-strong-random-secret-here-at-least-32-chars

# Trust proxy (set to 1 if behind a reverse proxy like Nginx)
TRUST_PROXY=1
